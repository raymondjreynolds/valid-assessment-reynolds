# GCS bucket name (private bucket for uploaded videos)
GCS_BUCKET_NAME=your-bucket-name

# Full service account JSON as a single-line string (must include private_key for V4 signed URLs)
GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Signed URL lifetime in seconds (default: 900 = 15 minutes)
SIGNED_URL_EXPIRATION_SECONDS=900
